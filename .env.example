# ══════════════════════════════════════════════════════════════════════════════
# .env.example — PatoCup
#
# INSTRUCCIONES:
#   1. Copiar este archivo:  cp .env.example .env
#   2. Rellenar cada valor marcado con <...> con tus credenciales reales
#   3. NUNCA subir .env al repositorio (.gitignore ya lo excluye)
#
# Estos valores se usan para desarrollo local (Postgres local o Supabase) y
# como referencia de qué variables hay que cargar en el dashboard de Railway.
# ══════════════════════════════════════════════════════════════════════════════


# ── PostgreSQL local (opcional, solo para probar la migración antes de usar
#    Supabase de verdad) ───────────────────────────────────────────────────────
POSTGRES_PASSWORD=<TuPasswordLocalDePrueba>


# ── Supabase (producción, vía Railway) ────────────────────────────────────────
# Password del usuario 'postgres'. Encontrar en:
# Supabase Dashboard → Settings → Database → Database password
SUPABASE_PASSWORD=<tu_password_de_supabase>

# Host del connection pooler (recomendado para Railway, no la conexión directa).
# Encontrar en: Supabase Dashboard → Settings → Database → Connection pooling → Host
SUPABASE_POOLER_HOST=<db.xxxxxxxxxxxxxxxxxxxx.pooler.supabase.com>

# Project ref (va como parte del username en modo pooler: postgres.<project_ref>).
# Encontrar en: Supabase Dashboard → Settings → General → Reference ID
SUPABASE_PROJECT_REF=<xxxxxxxxxxxxxxxxxxxx>


# ── JWT ─────────────────────────────────────────────────────────────────────
# Clave secreta para firmar los tokens (algoritmo HS256), mínimo 32 caracteres.
# Generar una aleatoria con: openssl rand -base64 32
JWT_SECRET_KEY=<clave_secreta_minimo_32_caracteres_aleatoria>


# ── Frontend ────────────────────────────────────────────────────────────────
# URL donde queda publicado el frontend en Netlify (para configurar CORS en Railway).
FRONTEND_URL=<https://tu-sitio.netlify.app>
