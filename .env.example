# ══════════════════════════════════════════════════════════════════════════════
# .env.example — PatoCup
#
# ⚠️  IMPORTANTE: estos nombres cortos (SUPABASE_PASSWORD, JWT_SECRET_KEY...) son
# SOLO una checklist de referencia para saber qué credenciales necesitas
# conseguir. NO son los nombres literales que hay que pegar en Railway.
#
# ASP.NET Core lee las variables de entorno con el patrón "Seccion__Clave"
# (doble guion bajo) y las mapea automáticamente a "Seccion": { "Clave": ... }
# de appsettings.json. Railway necesita esos nombres exactos, no los de acá
# abajo. Ver la sección "Variables reales para Railway" al final de este
# archivo para el mapeo directo, listo para copiar/pegar.
#
# INSTRUCCIONES (para desarrollo local con Postgres propio, opcional):
#   1. Copiar este archivo:  cp .env.example .env
#   2. Rellenar cada valor marcado con <...> con tus credenciales reales
#   3. NUNCA subir .env al repositorio (.gitignore ya lo excluye)
# ══════════════════════════════════════════════════════════════════════════════


# ── PostgreSQL local (opcional, solo para probar la migración antes de usar
#    Supabase de verdad) ───────────────────────────────────────────────────────
POSTGRES_PASSWORD=<TuPasswordLocalDePrueba>


# ── Supabase (producción, vía Railway) ────────────────────────────────────────
# Password del usuario 'postgres'. Encontrar en:
# Supabase Dashboard → Settings → Database → Database password → "Generate a
# new password" (Supabase NUNCA muestra la contraseña generada automáticamente
# al crear el proyecto -- si no la tienes guardada, hay que regenerarla).
SUPABASE_PASSWORD=<tu_password_de_supabase>

# Host del connection pooler EN MODO "Session pooler" (puerto 5432) -- NO
# "Direct connection" (esa solo es alcanzable por IPv6 en muchos casos) NI
# "Transaction pooler" (puerto 6543): verificado en despliegue real que desde
# Railway el Transaction pooler se queda colgado indefinidamente sin
# responder (nunca llega ni un error, ni una traza en los logs de Postgres de
# Supabase) mientras que el mismo host en el puerto del Session pooler
# conecta al instante. No quedó claro si es un problema puntual de red de
# Railway o algo más general del Transaction pooler -- si migras de
# plataforma, probar primero el Transaction pooler (es el recomendado por
# Supabase por defecto) y caer a Session pooler solo si hay timeouts.
# Encontrar en: Supabase Dashboard → Settings → Database → Connection string →
# selector "Session pooler".
SUPABASE_POOLER_HOST=<aws-0-xxxxxxxxx.pooler.supabase.com>

# Project ref (va como parte del username en modo pooler: postgres.<project_ref>).
# Encontrar en: Supabase Dashboard → Settings → General → Reference ID
SUPABASE_PROJECT_REF=<xxxxxxxxxxxxxxxxxxxx>


# ── JWT ─────────────────────────────────────────────────────────────────────
# Clave secreta para firmar los tokens (algoritmo HS256), mínimo 32 caracteres.
# Generar una aleatoria con: openssl rand -base64 32
JWT_SECRET_KEY=<clave_secreta_minimo_32_caracteres_aleatoria>


# ── Frontend ────────────────────────────────────────────────────────────────
# URL donde queda publicado el frontend en Netlify (para configurar CORS en Railway).
FRONTEND_URL=<https://tu-sitio.netlify.app>


# ══════════════════════════════════════════════════════════════════════════════
# Variables reales para Railway (Settings → Variables del servicio backend)
#
# Copiar estos 5 nombres EXACTOS (con doble guion bajo), reemplazando cada
# placeholder por el valor real que armaste arriba. IMPORTANTE: el formato de
# la connection string es "Clave=Valor;Clave=Valor" (formato ADO.NET/Npgsql),
# NO el formato "postgresql://usuario:pass@host/db" (formato URI) que muestra
# Supabase por defecto en su dashboard -- son incompatibles.
# ══════════════════════════════════════════════════════════════════════════════
#
# ConnectionStrings__DefaultConnection=Host=<SUPABASE_POOLER_HOST>;Port=5432;Database=postgres;Username=postgres.<SUPABASE_PROJECT_REF>;Password=<SUPABASE_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true;
# Jwt__Key=<JWT_SECRET_KEY>
# Jwt__Issuer=PatoCupAPI
# Jwt__Audience=PatoCupFrontend
# AppSettings__FrontendUrl=<FRONTEND_URL>
